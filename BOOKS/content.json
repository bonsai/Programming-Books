{
  "schema": "book-content-v1",
  "purpose": "エンタメWebサイト向けコンテンツ管理",
  "content_types": {
    "quiz": {
      "label": "クイズ",
      "format": "interactive",
      "fields": ["title", "question", "choices", "answer", "explanation", "difficulty", "category"]
    },
    "short": {
      "label": "ショート",
      "format": "short_text",
      "fields": ["title", "hook", "body", "ending", "tags"]
    },
    "short_sf": {
      "label": "ショートSF",
      "format": "fiction",
      "fields": ["title", "logline", "characters", "setting", "story", "twist", "ending"]
    },
    "novel": {
      "label": "小説",
      "format": "long_fiction",
      "fields": ["title", "synopsis", "characters", "world", "chapters", "status"]
    },
    "entertainment": {
      "label": "エンタメ",
      "format": "media",
      "fields": ["title", "category", "description", "ranking", "tags", "related_content"]
    },
    "website": {
      "label": "Webサイト",
      "format": "web",
      "fields": ["title", "description", "url", "content_type", "status", "analytics"]
    }
  },
  "lifecycle": ["idea", "research", "generate", "edit", "review", "publish", "measure", "improve"],
  "common": {
    "id": "string",
    "title": "string",
    "description": "string",
    "tags": [],
    "author": "string",
    "status": "draft",
    "created_at": "datetime",
    "updated_at": "datetime"
  },
  "relations": [
    "quiz -> short",
    "short -> short_sf",
    "short_sf -> novel",
    "novel -> entertainment",
    "entertainment -> website"
  ]
}
